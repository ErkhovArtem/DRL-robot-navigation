<mujoco model="g1 scene room">
  <include file="g1_12dof.xml"/>

  <statistic center="1.0 0.7 1.0" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0.9 0.9 0.9"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-140" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="wall" rgba="0.7 0.7 0.7 1" specular="0.3" shininess="0.5"/>
  <material name="cube1" rgba="0.8 0.3 0.3 1" specular="0.5" shininess="0.8"/>
  
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" />
    
    <!-- Room walls only (no obstacles) -->
    <!-- Front wall -->
    <geom name="wall_front" type="box" size="4.0 0.1 1.0" pos="0 4.0 1.0" material="wall"/>
    <!-- Back wall -->
    <geom name="wall_back" type="box" size="4.0 0.1 1.0" pos="0 -4.0 1.0" material="wall"/>
    <!-- Left wall -->
    <geom name="wall_left" type="box" size="0.1 4.0 1.0" pos="-4.0 0 1.0" material="wall"/>
    <!-- Right wall -->
    <geom name="wall_right" type="box" size="0.1 4.0 1.0" pos="4.0 0 1.0" material="wall"/>

    <geom name="cube1" type="box" size="3.0 0.1 1.5" pos="1 1 0.3" material="cube1"/>
    <geom name="cube2" type="box" size="0.1 1.5 1.5" pos="-2.0 -2.5 0.3" material="cube1"/>
    <geom name="cube3" type="box" size="1.5 0.1 1.5"   pos="-0.5 -2.5 0.3" material="cube1"/>
    <geom name="cube4" type="box" size="0.1 1.5 1.5"  pos="1 1 0.3" material="cube1"/>
    <geom name="cube5" type="box" size="1.5 0.1 1.5"  pos="-2.5 2.5 0.3" material="cube1"/>
    <geom name="cube6" type="box" size="0.1 1.0 1.5" pos="2.5 -3.0 0.3" material="cube1"/>

    <!-- Target point for path planning (position will be updated programmatically) -->
    <!-- Using mocap body - doesn't participate in physics but can be visualized and moved -->
    <body name="target_body" mocap="true" pos="0 0 0.3">
      <geom name="target_point" type="sphere" size="0.1" rgba="1.0 0.0 0.0 1.0" contype="0" conaffinity="0"/>
    </body>

  </worldbody>
</mujoco>

